namespace phraser;

// -------- Abstract StoreBlock --------

// BlockType is not used in those structures, because we need to know BlockType in order to deserialize
// - i.e. _prior_ to deserialization, so it can't be a part of the serialized structure itself.
// We still keep this enum for the reference.
enum BlockType : byte {
    Unknown = 0,//default value needs to be present
    FoldersBlock = 1,
    SymbolSetsBlock = 2,
    PhraseTemplatesBlock = 3,
    PhraseBlock = 4,
    KeyBlock = 5
}

// -------- Common block structure --------

struct StoreBlock {
  //type: BlockType;

  block_id: uint16;
  //This version is a global unique update version, as opposed to block version for a particular block
  version: uint32;

  //Use the sum of millis() and micros() to seed the random generator randomSeed(millis() + micros());
  entropy: uint64;
}

// -------- Folder / FoldersBlock --------

table Folder {
  folder_id: uint16;
  parent_folder_id: uint16;
  folder_name: string;
}

table FoldersBlock {
  block: StoreBlock;
  folders: [Folder];
}

// -------- SymbolSet / SymbolSetsBlock --------

//CRD only, immutable in storage
table SymbolSet {
  set_id: uint16;
  symbol_set_name: string;
  symbol_set: string;
}

table SymbolSetsBlock {
  block: StoreBlock;
  symbol_sets: [SymbolSet];
}

// -------- Word / PhraseDefinition / PhraseTemplate / PhraseTemplatesBlock --------

//Word is a template for a token of, e.g. login or password or url
table WordTemplate {
  word_template_id: uint16;
  //word permissions bitmask:
  //    - isViewable (can view text in Phraser UI)
  //    - isTypeable (can be typed via virtual USB keyboard)
  //    - isGenerateable (can be auto-generated based on symbol sets)
  //    - isUserEditable (can be directly edited by a user in Phraser UI)
  permissions: byte;
  icon: byte;//standard icon code - TODO: enum
  min_length: uint16;
  max_length: uint16;
  word_template_name: string;
  symbol_set_ids: [uint16];
}

//CRD only, immutable in storage
//PhraseTemplate is a template for a set of tokens, e.g. login/password/url
table PhraseTemplate {
  phrase_template_id: uint16;
  phrase_template_name: string;
  word_template_ids: [uint16];
}

table PhraseTemplatesBlock {
  block: StoreBlock;
  phrase_templates: [PhraseTemplate];
  word_templates: [WordTemplate];
}

// -------- StoreWordValue / StorePhraseHistory / PhraseBlock --------

table Word {
  word_template_id: uint16;
  name: string;
  word: string;
  permissions: byte;
  icon: byte;//standard icon code - TODO: enum
}

table PhraseHistory {
  phrase_template_id: uint16;
  phrase: [Word];
}

table PhraseBlock {
  block: StoreBlock;
  phrase_template_id: uint16;
  folder_id: uint16;
  is_tombstone: bool;
  phrase_name: string;
  //history[0] - current value (eg. current password), 1 - previous, 2 - the one before that, etc.
  history: [PhraseHistory];
}

// -------- // --------

//Other structs

table KeyBlock {
  block: StoreBlock;
  key: [byte];
  db_name: [byte];//encrypted DB name
  iv: [byte];
  bucket_count: uint16;
}
