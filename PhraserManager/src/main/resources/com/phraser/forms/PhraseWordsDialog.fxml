<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<fx:root minWidth="480.0" type="VBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <AnchorPane VBox.vgrow="NEVER">
        <GridPane fx:id="wordsGridPane" vgap="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints hgrow="NEVER" maxWidth="90" />
            </columnConstraints>
        </GridPane>
    </AnchorPane>
    <AnchorPane prefHeight="35.0" VBox.vgrow="NEVER">
        <Button fx:id="addButton" layoutX="97.0" layoutY="1.0" mnemonicParsing="false" onAction="#okClose" text="Add / Update" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="97.0" AnchorPane.rightAnchor="97.0" AnchorPane.topAnchor="10.0" />
    </AnchorPane>
</fx:root>
