<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="78.0" prefWidth="313.0" type="VBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <AnchorPane VBox.vgrow="NEVER">
      <children>
         <TextField fx:id="nameTextField" onKeyPressed="#closeOnEnter" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
      </children>
      <VBox.margin>
         <Insets left="10.0" right="10.0" top="10.0" />
      </VBox.margin>
    </AnchorPane>
    <AnchorPane prefHeight="35.0" VBox.vgrow="NEVER">
      <children>
           <Button fx:id="okButton" alignment="CENTER" mnemonicParsing="false" onAction="#okClose" text="Name" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />
      </children>
    </AnchorPane>
</fx:root>
