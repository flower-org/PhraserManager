                         <PropertyValueFactory property="id" />
                     </cellValueFactory>
                 </TableColumn>
                 <TableColumn minWidth="150.0" prefWidth="150.0" text="WordTemplate Name">
                     <cellValueFactory>
                         <PropertyValueFactory property="name" />
                     </cellValueFactory>
