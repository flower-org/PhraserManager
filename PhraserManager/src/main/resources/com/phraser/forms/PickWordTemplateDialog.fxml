    </AnchorPane>
    <AnchorPane prefHeight="35.0" VBox.vgrow="NEVER">
        <Button layoutX="97.0" layoutY="1.0" mnemonicParsing="false" onAction="#okClose" text="Pick" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="97.0" AnchorPane.rightAnchor="97.0" AnchorPane.topAnchor="10.0" />
    </AnchorPane>
</fx:root>
